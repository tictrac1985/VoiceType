<Window x:Class="VoiceType.App.MicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceType Mic"
        Width="330" Height="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Focusable="False" FontFamily="Segoe UI" FlowDirection="LeftToRight">
    <Grid>
        <!-- فقاعة الرسائل القصيرة (بجانب الزر، في الجهة التي فيها مساحة) -->
        <Border x:Name="Bubble" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,64,0"
                Background="#EE111827" CornerRadius="10" Padding="12,7" Visibility="Collapsed" MaxWidth="250" MaxHeight="112"
                BorderBrush="#22FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="#000000" />
            </Border.Effect>
            <TextBlock x:Name="BubbleText" Foreground="White" FontSize="13" TextWrapping="Wrap"
                       FlowDirection="RightToLeft" TextAlignment="Right" TextTrimming="WordEllipsis" />
        </Border>

        <!-- زر المايك: مصمم على مقاس 64، ويُكبَّر/يُصغَّر حسب الإعداد -->
        <Grid x:Name="MicButton" Width="64" Height="64" HorizontalAlignment="Right" VerticalAlignment="Center"
              Cursor="Hand" Background="Transparent"
              ToolTip="انقر للتحدث، وانقر مرة أخرى للإيقاف. اسحب لتحريكه. الزر الأيمن للخيارات.">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="SizeScale" ScaleX="0.75" ScaleY="0.75" />
            </Grid.LayoutTransform>

            <Grid x:Name="Visual" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>

                <!-- حلقة مستوى الصوت أثناء التسجيل -->
                <Ellipse x:Name="LevelRing" Width="50" Height="50" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <SolidColorBrush x:Name="LevelBrush" Color="#55EF4444" />
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="LevelScale" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- الجسم مع ظل ناعم بلون الزر -->
                <Ellipse x:Name="Body" Width="46" Height="46">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
                            <GradientStop x:Name="BodyTop" Color="#3B82F6" Offset="0" />
                            <GradientStop x:Name="BodyBottom" Color="#6366F1" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="Glow" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#4F46E5" />
                    </Ellipse.Effect>
                </Ellipse>

                <!-- لمعة زجاجية خفيفة في الأعلى -->
                <Ellipse Width="46" Height="46" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#40FFFFFF" Offset="0" />
                            <GradientStop Color="#08FFFFFF" Offset="0.5" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="46" Height="46" Stroke="#38FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />

                <!-- أيقونة المايك -->
                <Viewbox x:Name="MicIcon" Width="20" Height="20" IsHitTestVisible="False">
                    <Canvas Width="24" Height="24">
                        <Path Fill="White" Data="M12,2.2 C13.75,2.2 15.1,3.6 15.1,5.3 L15.1,11.2 C15.1,12.9 13.75,14.3 12,14.3 C10.25,14.3 8.9,12.9 8.9,11.2 L8.9,5.3 C8.9,3.6 10.25,2.2 12,2.2 Z" />
                        <Path Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M5.6,11 C5.6,14.6 8.5,17.4 12,17.4 C15.5,17.4 18.4,14.6 18.4,11 M12,17.4 L12,21.2" />
                    </Canvas>
                </Viewbox>

                <!-- أيقونة الإيقاف أثناء التسجيل -->
                <Rectangle x:Name="StopIcon" Width="15" Height="15" RadiusX="3.5" RadiusY="3.5" Fill="White" Visibility="Collapsed" IsHitTestVisible="False" />

                <!-- مؤشر المعالجة -->
                <Path x:Name="Spinner" Width="46" Height="46" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M23,4 A19,19 0 0 1 42,23" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" Angle="0" />
                    </Path.RenderTransform>
                </Path>
            </Grid>
        </Grid>
    </Grid>
</Window>
