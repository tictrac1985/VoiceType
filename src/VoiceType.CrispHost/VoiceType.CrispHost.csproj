<Project Sdk="Microsoft.NET.Sdk">
  <!--
    برنامج مساعد صغير يشغّل نماذج CrispASR (مثل Cohere Transcribe Arabic) في عملية منفصلة عن صدى.
    ليه منفصل؟ مكتبة CrispASR فيها ملفات بنفس أسماء ملفات Whisper.net (whisper.dll و ggml*.dll)،
    ولو اتحمّلوا في نفس البرنامج هيتعارضوا. وكمان لو المكتبة وقعت، صدى نفسه يفضل شغال.
    بيشتغل من غير نافذة (صدى بيشغّله مخفي)، وبيتكلم مع صدى بسطور JSON على stdin/stdout.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>VoiceType.CrispHost</AssemblyName>
    <RootNamespace>VoiceType.CrispHost</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
